  {
    "name": "v3 fetches",
    "file": "v3-fetches.json",
    "serialized": {
      "schemaVersion": 3,
      "secrets": [],
      "operations": [
        {
          "id": "fetch-file",
          "method": "GET",
          "url": "https://*/{*rest}",
          "effect": "read"
        },
        {
          "id": "notify",
          "method": "POST",
          "url": "https://*/ocm/notifications",
          "effect": "write"
        }
      ],
      "http": {
        "mount": "drive-prefix",
        "routes": [
          {
            "id": "shares",
            "path": "/ocm/shares",
            "methods": [
              "POST"
            ],
            "auth": "http-signature",
            "body": "json",
            "enqueues": [
              "notify"
            ],
            "fetches": [
              "fetch-file"
            ]
          }
        ]
      }
    },
    "gate": {
      "needed": "read-write",
      "listeners": [],
      "sidecars": [],
      "surfaces": [
        {
          "surface": "route `POST /ocm/shares`",
          "needs": "read-write"
        },
        {
          "surface": "delivery `notify`",
          "needs": "read-write"
        },
        {
          "surface": "fetch `fetch-file`",
          "needs": "read-write"
        }
      ]
    },
    "requires": [
      "persistent-host",
      "plugin-routes:read-write",
      "public-origin",
      "wasm-sandbox"
    ]
  },
