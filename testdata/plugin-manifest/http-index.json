  {
    "name": "v3 read-only route",
    "file": "v3-read-only-route.json",
    "serialized": {
      "schemaVersion": 3,
      "secrets": [],
      "operations": [],
      "http": {
        "routes": [
          {
            "id": "webfinger",
            "path": "/.well-known/webfinger",
            "methods": [
              "GET",
              "HEAD"
            ],
            "accept": [
              "application/jrd+json"
            ],
            "cors": "any-origin-no-credentials"
          },
          {
            "id": "profile",
            "path": "/users/{name}",
            "methods": [
              "GET"
            ]
          }
        ],
        "wellKnown": [
          {
            "name": "webfinger",
            "kind": "shared",
            "match": {
              "resourcePrefix": "acct:"
            },
            "route": "webfinger"
          }
        ],
        "reason": "Answers WebFinger lookups for this drive's handles."
      }
    },
    "gate": {
      "needed": "read-only",
      "listeners": [],
      "sidecars": [],
      "surfaces": [
        {
          "surface": "route `GET,HEAD /.well-known/webfinger`",
          "needs": "read-only"
        },
        {
          "surface": "route `GET /users/{name}`",
          "needs": "read-only"
        },
        {
          "surface": "well-known `webfinger`",
          "needs": "read-only"
        }
      ]
    },
    "requires": [
      "persistent-host",
      "plugin-routes:read-only",
      "public-origin",
      "wasm-sandbox"
    ]
  },
  {
    "name": "webfinger claim with rels",
    "file": "v3-webfinger-rels.json",
    "serialized": {
      "schemaVersion": 3,
      "secrets": [],
      "operations": [],
      "http": {
        "mount": "drive-host",
        "routes": [
          {
            "id": "webfinger",
            "path": "/webfinger",
            "methods": [
              "GET",
              "HEAD"
            ],
            "cors": "any-origin-no-credentials"
          }
        ],
        "wellKnown": [
          {
            "name": "webfinger",
            "kind": "shared",
            "match": {
              "resourcePrefix": "acct:",
              "rels": [
                "self",
                "http://webfinger.net/rel/profile-page"
              ]
            },
            "route": "webfinger"
          }
        ],
        "reason": "Answers WebFinger for this drive's actor, next to other claims for the same accounts."
      }
    },
    "gate": {
      "needed": "read-only",
      "listeners": [],
      "sidecars": [],
      "surfaces": [
        {
          "surface": "route `GET,HEAD /webfinger`",
          "needs": "read-only"
        },
        {
          "surface": "well-known `webfinger`",
          "needs": "read-only"
        }
      ]
    },
    "requires": [
      "persistent-host",
      "plugin-routes:read-only",
      "public-origin",
      "wasm-sandbox"
    ]
  },
  {
    "name": "v3 activitypub",
    "file": "v3-activitypub.json",
    "gate": {
      "needed": "read-write",
      "listeners": [],
      "sidecars": [],
      "surfaces": [
        {
          "surface": "route `GET,HEAD /users/{name}`",
          "needs": "read-only"
        },
        {
          "surface": "route `POST /users/{name}/inbox`",
          "needs": "read-write"
        },
        {
          "surface": "route `GET /nodeinfo`",
          "needs": "read-only"
        },
        {
          "surface": "route `PUT,DELETE /files/{*rest}`",
          "needs": "read-write"
        },
        {
          "surface": "well-known `nodeinfo`",
          "needs": "read-only"
        },
        {
          "surface": "write target `inbox-items`",
          "needs": "read-write"
        },
        {
          "surface": "key `actor-key`",
          "needs": "read-write"
        },
        {
          "surface": "token store `storage`",
          "needs": "read-write"
        },
        {
          "surface": "delivery `deliver`",
          "needs": "read-write"
        }
      ]
    },
    "requires": [
      "persistent-host",
      "plugin-routes:read-write",
      "public-origin",
      "wasm-sandbox"
    ]
  },
