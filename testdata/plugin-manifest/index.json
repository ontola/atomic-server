  {
    "name": "v2 js extension",
    "file": "v2-js-extension.json",
    "serialized": {
      "schemaVersion": 2,
      "capabilities": [
        "storage",
        {
          "name": "extended-fuel",
          "reason": "Syncs whole calendars"
        }
      ],
      "secrets": [
        {
          "name": "google",
          "origin": "https://www.googleapis.com",
          "description": "Calendar token"
        }
      ],
      "operations": [
        {
          "id": "events",
          "method": "GET",
          "url": "https://www.googleapis.com/calendar/v3/calendars/primary/events",
          "effect": "read"
        }
      ],
      "network": {
        "origins": [
          "https://www.googleapis.com"
        ],
        "reason": "Reads calendars"
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "calendar": {
            "type": "string"
          }
        }
      },
      "defaultConfig": {
        "calendar": "primary"
      },
      "name": "google-calendar",
      "namespace": "atomic",
      "version": "1.0.0",
      "description": "Mirrors a calendar",
      "author": "Ontola"
    }
  },
