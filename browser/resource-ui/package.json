      "types": "./dist/locales/main.loader.d.ts",
      "import": "./dist/locales/main.loader.js"
    },
    "./locale-message": {
      "types": "./dist/locales/message.d.ts",
      "import": "./dist/locales/message.js"
    }
  },
  "source": "src/index.ts",
  "peerDependencies": {
    "react": "^19.2.0",
