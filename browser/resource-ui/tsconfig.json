{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "paths": {
      "@tomic/resource-ui": ["./src/index.ts"],
      "@tomic/resource-ui/*": ["./src/*"],
      "@tomic/resource-ui/locale-runtime": ["./src/locales/main.loader.js"]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.testing.ts"]
}
