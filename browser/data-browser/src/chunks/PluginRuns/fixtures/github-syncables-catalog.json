    "/repos/{owner}/{repo}/issues/{issue_number}/labels": {
      "post": {
        "operationId": "issues-add-labels",
        "summary": "Add labels to an issue",
        "description": "Adds the named labels, keeping the issue's other labels. A name the repository has no label for creates that label with a default colour; a label already on the issue is left as is.",
        "security": [
          {
            "githubOAuth": ["repo"]
          }
        ],
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "issue_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["labels"],
                "properties": {
                  "labels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every label now on the issue (not the issue).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/label"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such repository or issue, or no access."
          },
          "410": {
            "description": "Issues are turned off for the repository."
          },
          "422": {
            "description": "Validation failed."
          }
        },
        "x-crud": {
          "action": "update",
          "mode": "patch",
          "patchFormat": "custom",
          "resource": "issue",
          "description": "Adds labels to the issue's `labels`; other labels are kept. Not a merge patch: the body names labels to add, and the response is the issue's full label list, not the issue. Repeating it is harmless."
        }
      }
    },
    "/repos/{owner}/{repo}/issues/{issue_number}/labels/{name}": {
      "delete": {
