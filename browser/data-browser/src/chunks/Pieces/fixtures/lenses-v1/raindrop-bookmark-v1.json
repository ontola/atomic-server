{
  "@id": "https://ontola.github.io/atomic-plugins/ontology/lenses/raindrop-bookmark-v1",
  "lensFormat": 1,
  "release": "https://ontola.github.io/atomic-plugins/ontology/lenses/v1",
  "name": "Raindrop bookmark ↔ Bookmark",
  "description": "A Raindrop.io bookmark record and the host's built-in Bookmark class: title, link and excerpt.",
  "source": {
    "record": {
      "provider": "raindrop.io",
      "resource": "raindrop"
    }
  },
  "target": {
    "class": "https://atomicdata.dev/class/Bookmark"
  },
  "mapping": {
    "version": 2,
    "fields": [
      {
        "source": "/title",
        "target": "https://atomicdata.dev/properties/name"
      },
      {
        "source": "/link",
        "target": "https://atomicdata.dev/property/url"
      },
      {
        "source": "/excerpt",
        "target": "https://atomicdata.dev/properties/description"
      }
    ]
  },
  "limits": [
    "No overlay declares a Raindrop crudResource yet, so no catalog integration produces this source; the record endpoint names the shape the code lens reads.",
    "No domain guard: the code lens refuses a non-positive id, titles over 1000 and excerpts over 10000 UTF-16 code units, and a link that is not an absolute http(s) URL.",
    "A row without a description leaves the excerpt unchanged; the code lens writes an empty excerpt. Removal is not expressible."
  ],
  "implementation": "integrations/bookmarks/devonian/raindrop/lens/index.ts",
  "examples": [
    {
      "source": {
        "_id": 41,
        "title": "A bookmark",
        "link": "https://example.org/article",
        "tags": [
          "invented"
        ],
        "note": "Provider-only note",
        "created": "2026-10-01T12:00:00+02:00"
      },
      "target": {
        "https://atomicdata.dev/properties/name": "A bookmark",
        "https://atomicdata.dev/property/url": "https://example.org/article"
      },
      "edits": [
        {
          "target": {
            "https://atomicdata.dev/properties/name": "Changed",
            "https://atomicdata.dev/property/url": "https://example.org/article",
            "https://atomicdata.dev/properties/description": "Edited"
          },
          "source": {
            "_id": 41,
            "title": "Changed",
            "link": "https://example.org/article",
            "tags": [
              "invented"
            ],
            "note": "Provider-only note",
            "created": "2026-10-01T12:00:00+02:00",
            "excerpt": "Edited"
          }
        }
      ]
    }
  ]
}
