{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": "../..",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "composite": false,
    "paths": {
      "@tomic/react": [
        "../react/src/index.ts"
      ],
      "@tomic/lib": [
        "../lib/src/index.ts"
      ],
      "@tomic/lib/calendar-recurrence.js": [
        "../lib/src/calendar-recurrence.ts"
      ],
      "@integration-host/import-records": [
        "../lib/src/import-records.ts"
      ],
      "@integration-host/plugin-connection": [
        "../lib/src/plugin-connection.ts"
      ],
      "@integration-host/plugin-reconcile": [
        "../lib/src/plugin-reconcile.ts"
      ],
      "@integration-host/navigation": [
        "./src/helpers/navigation.tsx"
      ],
      "@integration-host/runScript": [
        "./src/chunks/PluginRuns/runScript.ts"
      ],
      "@integration-host/RunPluginDialog": [
        "./src/chunks/PluginRuns/RunPluginDialog.tsx"
      ],
      "@integration-host/table/createTableFromSpec": [
        "./src/chunks/TablePage/createTableFromSpec.ts"
      ],
      "@integration-host/table/tableTemplates": [
        "./src/chunks/TablePage/tableTemplates.ts"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@views/*": [
        "./src/views/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@chunks/*": [
        "./src/chunks/*"
      ],
      "@repo-lib-defaults/*": [
        "../../lib/defaults/*"
      ],
      "@tomic/table": [
        "../table/src/index.ts"
      ]
    }
  }
}
