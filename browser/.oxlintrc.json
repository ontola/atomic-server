{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "plugins": ["eslint", "typescript", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off"
  },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off",
    "no-redeclare": "off",
    "no-shadow": "off",
    "eslint/no-unused-vars": "off",
    "eslint/no-shadow": "off",
    "class-methods-use-this": "off",
    "eqeqeq": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_|^e"
      }
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-shadow": "error",
    "no-console": [
      "warn",
      {
        "allow": [
          "error",
          "warn",
          "debug",
          "info",
          "group",
          "groupCollapsed",
          "groupEnd"
        ]
      }
    ],
    "react/no-unknown-property": [
      "warn",
      {
        "ignore": ["about"]
      }
    ],
    // React Compiler recommended rules (oxlint 1.79). `correctness: error`
    // already turns most of these on; they are listed so the three high-volume
    // ones can stay warn until those call sites are cleaned up. See
    // https://oxc.rs/blog/2026-08-18-react-compiler-support.html
    "react/error-boundaries": "error",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/unsupported-syntax": "error",
    // 58 / 39 / 29 hits today: prop-sync effects, latest-ref during render,
    // and `const Comp = getButtonComp()` during render. Warn until cleaned up.
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/static-components": "warn",
    // The compiler's own memoization makes exhaustive-deps less load-bearing.
    "react-hooks/exhaustive-deps": "warn",
    "no-useless-escape": "off",
    "no-useless-rename": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "next": "return", "prev": "*" },
      { "blankLine": "always", "next": "export", "prev": "*" },
      { "blankLine": "always", "next": "multiline-block-like", "prev": "*" },
      { "blankLine": "always", "next": "*", "prev": "multiline-block-like" },
      { "blankLine": "any", "next": "export", "prev": "export" }
    ]
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/lib-out",
    "**/build",
    "**/.svelte-kit",
    "**/.netlify",
    "**/src/locales/**"
  ],
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.test.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off"
      }
    }
  ]
}
