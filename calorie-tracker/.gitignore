# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Xcode writes these when a pod pulls a Swift Package — flutter_image_compress
# brings in SDWebImage's libwebp on iOS. This project integrates through
# CocoaPods (Podfile, podspec, `pod install`), so an SPM lockfile nothing here
# reads is just build output that turns up in `git status` after every build.
ios/**/xcshareddata/swiftpm/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust build output (the FRB crate builds out-of-tree from cargokit too)
rust/target/

# dev.sh per-target run logs
/logs/
