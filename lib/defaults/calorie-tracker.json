      "https://atomicdata.dev/properties/imagePath",
      "https://atomicdata.dev/properties/estimateConfidence",
      "https://atomicdata.dev/properties/estimatedByModel",
      "https://atomicdata.dev/properties/clarifyingQuestion",
      "https://atomicdata.dev/properties/mealNotes",
      "https://atomicdata.dev/properties/mealEmbedding",
      "https://atomicdata.dev/properties/embeddedByModel",
      "https://atomicdata.dev/properties/copiedFromMeal",
      "https://atomicdata.dev/properties/proteinGrams",
      "https://atomicdata.dev/properties/carbsGrams",
      "https://atomicdata.dev/properties/fatGrams"
    ],
