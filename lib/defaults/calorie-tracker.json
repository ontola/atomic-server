    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/string",
    "https://atomicdata.dev/properties/description": "Identifier of the model that produced the estimate, so a number can be traced back to what made it. Empty when a human entered it.",
    "https://atomicdata.dev/properties/isA": ["https://atomicdata.dev/classes/Property"],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "estimated-by-model"
