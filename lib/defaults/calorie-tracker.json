    "https://atomicdata.dev/properties/shortname": "fat-grams"
  },
  {
    "@id": "https://atomicdata.dev/classes/Meal",
    "https://atomicdata.dev/properties/description": "Something eaten or drunk at a moment in time, with an estimate of its energy content. Created the instant it is captured — before anyone knows what it was — so `consumed-at` and `meal-status` are all that is required of it; the name, the numbers and the macros arrive later, when it has been estimated.",
    "https://atomicdata.dev/properties/isA": ["https://atomicdata.dev/classes/Class"],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
