[
  {
    "@id": "https://atomicdata.dev/ontology/notifications",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/class/ontology"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/ontology",
    "https://atomicdata.dev/properties/shortname": "notifications",
    "https://atomicdata.dev/properties/description": "Telling someone that something happened that concerns them: a new message in a chat they're in, a comment on something they made, a reply to them. Each event becomes a Notification in the Inbox of the recipient's private drive, so what they have read is the same on every device.\n\nToday the recipient's own apps write the Notifications, from data they can already read. The Inbox is also where others will be able to deliver to later (a first message from a stranger, a service, a bridge to another network), through a narrow right to append new items that only the recipient can read. See `planning/authorization-sync.md`.\n\nThe server notifier (`lib/src/notify.rs`) also writes into the Inbox, for what its owner follows (`Follow`) and for `Announcement`s addressed to them, and hands each new Notification to push (`PushRegistration`) and e-mail. Preferences live on the Inbox. See `planning/notifications.md`.",
    "https://atomicdata.dev/properties/classes": [
      "https://atomicdata.dev/classes/Inbox",
      "https://atomicdata.dev/classes/Notification",
      "https://atomicdata.dev/classes/Follow",
      "https://atomicdata.dev/classes/PushRegistration",
      "https://atomicdata.dev/classes/Announcement"
    ],
    "https://atomicdata.dev/properties/properties": [
      "https://atomicdata.dev/properties/inbox",
      "https://atomicdata.dev/properties/notificationSource",
      "https://atomicdata.dev/properties/notificationKind",
      "https://atomicdata.dev/properties/actor",
      "https://atomicdata.dev/properties/occurredAt",
      "https://atomicdata.dev/properties/readAt",
      "https://atomicdata.dev/properties/followLevel",
      "https://atomicdata.dev/properties/followClasses",
      "https://atomicdata.dev/properties/followProperties",
      "https://atomicdata.dev/properties/recipients",
      "https://atomicdata.dev/properties/actionRequired",
      "https://atomicdata.dev/properties/notificationCount",
      "https://atomicdata.dev/properties/changedProperties",
      "https://atomicdata.dev/properties/notifyEmail",
      "https://atomicdata.dev/properties/emailFrequency",
      "https://atomicdata.dev/properties/mutedNotificationKinds",
      "https://atomicdata.dev/properties/notifyLanguage",
      "https://atomicdata.dev/properties/pushEndpoint"
    ]
  },
  {
    "@id": "https://atomicdata.dev/classes/Inbox",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Class"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
    "https://atomicdata.dev/properties/shortname": "inbox",
    "https://atomicdata.dev/properties/description": "Where Notifications for one person arrive. Lives in their private drive, which points to it with `inbox`.",
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/name"
    ]
  },
  {
    "@id": "https://atomicdata.dev/classes/Notification",
