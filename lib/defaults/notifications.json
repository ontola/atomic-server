    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/timestamp",
    "https://atomicdata.dev/properties/description": "When the event happened, which is not when the Notification was written: a device that was offline can write it later."
  },
  {
    "@id": "https://atomicdata.dev/properties/readAt",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "read-at",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/timestamp",
    "https://atomicdata.dev/properties/description": "When the recipient read this Notification. Absent while it is unread."
  },
  {
    "@id": "https://atomicdata.dev/classes/Follow",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Class"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
    "https://atomicdata.dev/properties/shortname": "follow",
    "https://atomicdata.dev/properties/description": "Something the owner of the Inbox it is in wants to hear about: `about` (a resource, folder or drive, and everything below it), at a `followLevel`. `followClasses` and `followProperties` narrow it. The nearest Follow above a change decides, so a muted folder inside a followed drive stays quiet.",
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/about"
    ],
    "https://atomicdata.dev/properties/recommends": [
      "https://atomicdata.dev/properties/followLevel",
      "https://atomicdata.dev/properties/followClasses",
      "https://atomicdata.dev/properties/followProperties"
    ]
  },
  {
    "@id": "https://atomicdata.dev/classes/PushRegistration",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Class"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
    "https://atomicdata.dev/properties/shortname": "push-registration",
    "https://atomicdata.dev/properties/description": "One device of the Inbox's owner that wants push messages while its app is closed. `pushEndpoint` is the URL its push distributor (for example a UnifiedPush app) gave it; the server POSTs a small JSON message there.",
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/pushEndpoint"
    ],
    "https://atomicdata.dev/properties/recommends": [
      "https://atomicdata.dev/properties/name"
    ]
  },
  {
    "@id": "https://atomicdata.dev/classes/Announcement",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Class"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
    "https://atomicdata.dev/properties/shortname": "announcement",
    "https://atomicdata.dev/properties/description": "Someone telling chosen `recipients` about `about`, for example a new version of a document, whether or not they follow it. `actionRequired` marks that the recipient has to do something. Each recipient who can read it gets one Notification. Only someone who may write where the Announcement is can send one.",
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/recipients"
    ],
    "https://atomicdata.dev/properties/recommends": [
      "https://atomicdata.dev/properties/name",
      "https://atomicdata.dev/properties/description",
      "https://atomicdata.dev/properties/about",
      "https://atomicdata.dev/properties/actionRequired"
    ]
  },
  {
    "@id": "https://atomicdata.dev/properties/followLevel",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "follow-level",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/string",
    "https://atomicdata.dev/properties/description": "`everything` (new items and changes), `newItems` (only new resources below `about`), `changes` (only changes, no new items) or `muted` (nothing, also not what a Follow higher up would send)."
  },
  {
