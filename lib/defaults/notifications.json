    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "notification-count",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/integer",
    "https://atomicdata.dev/properties/description": "How many events one Notification stands for (edits are batched, and an unread Notification grows instead of getting a sibling)."
  },
