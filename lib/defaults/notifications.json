      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "follow-properties",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/resourceArray",
    "https://atomicdata.dev/properties/description": "Only changes to one of these properties notify (new items always do). Empty: any change.",
    "https://atomicdata.dev/properties/classtype": "https://atomicdata.dev/classes/Property"
  },
  {
    "@id": "https://atomicdata.dev/properties/recipients",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "recipients",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/resourceArray",
    "https://atomicdata.dev/properties/description": "The agents an Announcement is for.",
    "https://atomicdata.dev/properties/classtype": "https://atomicdata.dev/classes/Agent"
  },
