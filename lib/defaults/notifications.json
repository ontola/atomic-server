    "https://atomicdata.dev/properties/shortname": "action-required",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/boolean",
    "https://atomicdata.dev/properties/description": "The recipient is expected to do something about it."
  },
  {
