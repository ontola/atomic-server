    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/json",
    "https://atomicdata.dev/properties/description": "On the Inbox: Notification kinds the owner does not want, such as `[\"changed\"]`. Kinds: `created`, `changed`, `announcement`, `chat`, `comment`, `reply`, `mention`."
  },
  {
    "@id": "https://atomicdata.dev/properties/notifyLanguage",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Property"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/properties",
    "https://atomicdata.dev/properties/shortname": "notify-language",
    "https://atomicdata.dev/properties/datatype": "https://atomicdata.dev/datatypes/string",
    "https://atomicdata.dev/properties/description": "On the Inbox: the language (BCP 47, such as `nl`) of the texts the server writes for its owner."
  },
  {
    "@id": "https://atomicdata.dev/properties/pushEndpoint",
