    ],
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/name"
    ],
    "https://atomicdata.dev/properties/shortname": "meeting"
  },
  {
    "@id": "https://atomicdata.dev/properties/currentMeetings",
