      "https://atomicdata.dev/properties/description"
    ],
    "https://atomicdata.dev/properties/shortname": "follow-event"
  },
  {
    "@id": "https://atomicdata.dev/classes/Meeting",
    "https://atomicdata.dev/properties/description": "A live, joinable session in a Drive: a ChatRoom with a leader. While a Meeting is listed in its Drive's `currentMeetings` and the leader's presence entry points at it (`session`), clients show a prominent join affordance; joining means following the leader and opening this room. After it ends, the Meeting remains as a browsable log (minutes). Meetings are also ChatRooms (both classes are set).",
    "https://atomicdata.dev/properties/isA": [
      "https://atomicdata.dev/classes/Class"
    ],
    "https://atomicdata.dev/properties/parent": "https://atomicdata.dev/classes",
