<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ontola.atomiccanvas_flutter">
    <!-- Flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- A dev server on the LAN is plain http, which Android has blocked by
         default since 9 — so a phone testing against one would report every
         server unreachable. Debug builds only, merged in here rather than set
         in the main manifest, so a released app can never quietly talk
         cleartext. Same split the Tauri app makes with its
         `usesCleartextTraffic` manifest placeholder. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
