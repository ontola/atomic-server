# Copy to .env. Nothing here is required to run the test suite.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://postgres@127.0.0.1:54329/pauseai_crm
APP_ORIGIN=http://localhost:5173
# sandbox (default): outbound email is logged, never sent. live: send via MailerSend.
EMAIL_MODE=sandbox
MAILERSEND_API_KEY=
EMAIL_FROM="PauseAI CRM <crm@pauseai.info>"
# Emails that receive global_admin on their first sign-in. Comma separated.
BOOTSTRAP_ADMIN_EMAILS=
# Development only: print magic links to the console instead of emailing them.
AUTH_DEV_PRINT_LINKS=true

# --- Airtable (read: PauseAI Volunteers & Actions base) --------------------
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appWPTGqZmUcs3NWu
AIRTABLE_MEMBERS_TABLE_ID=tblL1icZBhTV1gQ9o
AIRTABLE_CHAPTERS_TABLE_ID=tblEQJ26hxBAEkaP8

# --- Discord, via PauseBot -----------------------------------------------
# Shared secret PauseBot uses to sign the events it posts to /api/webhooks/pausebot.
PAUSEBOT_WEBHOOK_SECRET=
# Where PauseBot's web server lives, and its WEBHOOK_SECRET, for assigning roles.
PAUSEBOT_URL=
PAUSEBOT_API_SECRET=
