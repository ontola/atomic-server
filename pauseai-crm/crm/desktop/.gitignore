# Generated by Cargo
# will have compiled files and executables
/target/
WixTools

# Android build outputs (regenerated by cargo tauri android dev)
/gen/android/build/
/gen/android/app/build/
/gen/android/app/src/main/jniLibs/

# Auto-generated Android Studio project files
/gen/android/.idea/

# Signing material. keystore.properties holds the release keystore's store and
# key passwords in plain text, and was committed to this PUBLIC repo in
# "Run on android #25" until 2026-08-02. The .jks itself was never committed, so
# the passwords alone do not sign anything -- but treat them as burned and
# rotate rather than assume the keystore file stayed private.
#
# In CI the file is written from secrets at build time. app/build.gradle.kts
# guards with `if (keystorePropertiesFile.exists())`, so when it is absent the
# release build is simply unsigned instead of failing.
/gen/android/keystore.properties
/gen/android/local.properties
*.jks
*.keystore

/dist/
