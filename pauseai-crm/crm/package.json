{
  "name": "@pauseai/crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PauseAI CRM: volunteer, chapter and stakeholder management for PauseAI Global and national chapters",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "worker": "tsx src/worker.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "bash scripts/local-postgres.sh",
    "sync:airtable": "tsx scripts/sync-airtable.ts",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.70.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "svelte": "^5.56.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "drizzle-kit": "^0.31.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
